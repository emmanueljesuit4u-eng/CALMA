{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document for authenticated users",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase user UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp"
        }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User documents storing profile details"
    }
  }
}
